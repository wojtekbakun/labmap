# LabMap settings - install.sh copies this file to /etc/labmap.env.
# Check your names with: ip link, cat /proc/mdstat

LABMAP_LAN_INTERFACE=eth0
LABMAP_WIFI_INTERFACE=wlan0
LABMAP_TAILSCALE_INTERFACE=tailscale0
LABMAP_RAID_DEVICE=md0
LABMAP_RAID_MOUNT=/srv/data

# Where Immich and Nextcloud answer on the server itself
LABMAP_IMMICH_URL=http://127.0.0.1:2283
LABMAP_NEXTCLOUD_URL=http://127.0.0.1:8081
LABMAP_IMMICH_BACKUPS=/srv/data/immich/backups
