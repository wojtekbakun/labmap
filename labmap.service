[Unit]
Description=LabMap – a live map of your home server
After=network-online.target docker.service
Wants=network-online.target

[Service]
# install.sh fills in @USER@ and @CONFIG@
User=@USER@
Group=@USER@
SupplementaryGroups=docker
Environment=LABMAP_PORT=80 LABMAP_CONFIG=@CONFIG@
EnvironmentFile=-/etc/labmap.env
# The code runs from a copy on the system disk, so LabMap can still report a missing data disk. This line makes
# the first copy; later changes in @CONFIG@ are copied over by LabMap itself (update_copy).
StateDirectory=labmap
ExecStartPre=-/bin/sh -c 'test -f /var/lib/labmap/labmap.py || cp @CONFIG@/labmap.py @CONFIG@/index.html @CONFIG@/services.json /var/lib/labmap/'
ExecStart=/usr/bin/python3 -I /var/lib/labmap/labmap.py
Restart=always
RestartSec=10
# Only the LAN cable, Tailscale and the server itself may connect; install.sh sets IPAddressAllow in a drop-in.
# This also keeps the service off the internet - the internet speed test runs in a throwaway container instead.
IPAddressDeny=any
# port 80 without root; LabMap only reads - the rest of the system is locked away from it
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
